# Example Environment Variables

# API origin for every REST call and media URL.
# The value must contain the mount point only ONCE:
#   - Development: http://127.0.0.1:8000/api  (or "/api" to use the Vite proxy)
#   - Production:  https://your-api-host.example.com   (the client appends /api)
#                 or https://your-api-host.example.com/api
# Media paths returned by the backend already start with "/api/media/serve/…";
# the shared resolveMediaUrl() helper strips that prefix once and re-resolves
# against this base, so both forms above produce a single "/api" segment.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# WebSocket origin (no /api suffix). Falls back to VITE_API_BASE_URL host.
VITE_WS_BASE_URL=ws://127.0.0.1:8000

# Google OAuth Client ID — copy from backend/.env GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
