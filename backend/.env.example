# Copy this to .env and fill in your values
# On Railway, set these as Environment Variables in the dashboard

# Django
SECRET_KEY=your-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-app.railway.app

# Database (Railway auto-provides this when you add PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (Railway auto-provides this when you add Redis)
REDIS_URL=redis://default:password@host:6379

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your@gmail.com

# HuggingFace AI
HF_API_KEY=hf_your_key_here

# CORS (your Railway domain)
CORS_ALLOWED_ORIGINS=https://your-app.railway.app

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

