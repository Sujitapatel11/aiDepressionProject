# Copy this to .env and fill in your values
# On Railway, set these as Environment Variables in the dashboard

# Django
SECRET_KEY=your-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-app.railway.app

# Database (Railway auto-provides this when you add PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (Railway auto-provides this when you add Redis)
REDIS_URL=redis://default:password@host:6379

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your@gmail.com

# HuggingFace AI
HF_API_KEY=hf_your_key_here

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://your-app.railway.app
# Optional Django HTTPS redirect (Render edge proxy handles this by default)
# SECURE_SSL_REDIRECT=false

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==========================================================================
# Media storage — REQUIRED for production (DEBUG=False)
# ==========================================================================
# When DEBUG=False the backend refuses to start without persistent media
# storage, so uploads can never silently land on an ephemeral filesystem.
# Preferred: a private Cloudflare R2 bucket (S3-compatible). Set ALL FOUR:
CLOUDFLARE_R2_ACCOUNT_ID=your-r2-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=your-private-bucket-name
# Optional: explicit endpoint (default derives from the account id)
# CLOUDFLARE_R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
# Optional tuning: presigned URL lifetime (seconds) and free-tier ceilings
# SOULCARE_R2_PRESIGN_TTL=600
# SOULCARE_R2_MAX_STORAGE_GB=9
# SOULCARE_R2_WARN_STORAGE_GB=8
# SOULCARE_R2_MAX_PUT_OPS=800000
# SOULCARE_R2_MAX_GET_OPS=8000000

# Local attachments limit (defaults shown)
# SOULCARE_MAX_IMAGE_MB=10
# SOULCARE_MAX_VIDEO_MB=100
# SOULCARE_MAX_MEDIA_FILES=6
# SOULCARE_ORPHAN_MEDIA_HOURS=24

# Explicit opt-out: store media on a PERSISTENT mounted volume instead of R2.
# Never enable this on an ephemeral filesystem (files are lost on redeploy).
# SOULCARE_ALLOW_LOCAL_MEDIA_STORAGE=true
# MEDIA_ROOT=/data/media

# Whether the frontend is served from a different origin than the API
# (adds FRONTEND_URL to CORS/CSRF trusted origins)
# FRONTEND_URL=https://your-frontend.vercel.app
# BACKEND_URL=https://your-api-host.example.com

# Channels fan-out. Production requires REDIS_URL (WebSocket messages must be
# shared across workers). Explicit opt-out below is for single-worker setups.
# SOULCARE_ALLOW_IN_MEMORY_CHANNELS=true


